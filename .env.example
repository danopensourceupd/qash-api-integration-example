# Copy to .env (git-ignored) and fill in. Never commit real values.

# Sandbox is the default. Production hosts are refused by this example.
QASH_BASE_URL=https://sandbox.qash.ai

# Partner API key pair from the Qash dashboard or `npm run cli -- keys:create`.
QASH_API_KEY=
QASH_API_SECRET=

# Safety switches. Anything that creates resources needs QASH_ENABLE_WRITES=true.
# Transfers and approvals additionally need QASH_ENABLE_MONEY_MOVEMENT=true.
QASH_ENABLE_WRITES=false
QASH_ENABLE_MONEY_MOVEMENT=false

# Optional
QASH_TIMEOUT_MS=30000
QASH_STATE_FILE=.state/session.json

# End-to-end tests
# Email template for users the tests register. {tag} is replaced with a unique value.
QASH_E2E_EMAIL_TEMPLATE=qash-example+{tag}@example.com
# Id of the API key the logged-in test user is bound to (used by the limits suite).
QASH_E2E_KEY_ID=

# Approval hook example server (`npm run cli -- hook:serve`)
QASH_HOOK_SECRET=
QASH_HOOK_PORT=8443
QASH_HOOK_MAX_AMOUNT=0
QASH_HOOK_ASSETS=USDC
