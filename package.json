{
  "name": "qash-api-integration-example",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial, community example of integrating the Qash partner API from a Node.js backend.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:e2e": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/e2e/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "cli": "node --env-file-if-exists=.env src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
